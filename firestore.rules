rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // posts under countries/{country}/domains/local_news/posts/{postId}
    match /countries/{country}/domains/local_news/posts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.location != null
        && request.resource.data.geoPath is string;

      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if request.auth != null
          && (resource.data.isSecret == false || request.auth.uid in resource.data.visibleToUserIds);
        
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.postId == postId
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.isDeleted == false
          && request.resource.data.isSecret is bool
          && request.resource.data.postOwnerId is string
          && request.resource.data.visibleToUserIds is list
          && (request.auth.uid in request.resource.data.visibleToUserIds)
          && (request.resource.data.postOwnerId in request.resource.data.visibleToUserIds);
        
        allow update, delete: if request.auth != null
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.postId == resource.data.postId
          && request.resource.data.postOwnerId == resource.data.postOwnerId
          && request.resource.data.visibleToUserIds == resource.data.visibleToUserIds
          && request.resource.data.isSecret == resource.data.isSecret;
      }
    }
    
    // [헬퍼 함수]
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // [1] 사용자 프로필
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      match /fcm_tokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      match /blocked_users/{blockedUserId} {
        allow read, write: if isOwner(userId);
      }

      match /private_deal_codes/{dealId} {
        allow read, create: if isOwner(userId);
        allow update, delete: if false;
      }
    }

    // [2] 국가별 도메인 게시글 (Path-sharded architecture)
    // 경로: countries/{countryId}/domains/{domainId}/posts/{postId}
    match /countries/{countryId}/domains/{domainId}/posts/{postId} {
      
      // 누구나 읽기 가능 (하위 로컬 정책에 따라 필터링될 수 있음)
      allow read: if isAuthenticated();
      
      // 작성 및 수정 규칙
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.geoPath.size() > 0
        && request.resource.data.trustScore >= 0.0;
        
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId; // 작성자 변경 금지
        
      allow delete: if isOwner(resource.data.userId);
    }

    // [Marketplace Products]
    // 경로: countries/{country}/domains/marketplace/products/{productId}
    match /countries/{country}/domains/marketplace/products/{productId} {
      allow read: if isAuthenticated() && resource.data.isDeleted == false;

      allow create: if isAuthenticated()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && (request.resource.data.price is int || request.resource.data.price is number)
        && request.resource.data.price >= 0
        && request.resource.data.countryCode is string
        && request.resource.data.geoPath is string
        && request.resource.data.isDeleted == false;

      allow update: if isAuthenticated()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId; // immutable sellerId

      allow delete: if isAuthenticated() && resource.data.sellerId == request.auth.uid;

      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.productId == productId;
        allow delete: if isAuthenticated() && request.auth.uid == userId;
        allow update: if false;
      }

      match /ai_reports/{reportId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.sellerId == request.auth.uid
          && request.resource.data.productId == productId;
        allow update, delete: if false;
      }
    }

    function marketplaceAdminRole() {
      return request.auth.token.marketplaceAdminRole;
    }
    
    function canViewMarketplaceReviewQueue() {
      return isAuthenticated() &&
        marketplaceAdminRole() in ['reviewer', 'admin', 'superAdmin'];
    }

    function canModerateMarketplaceReviewQueue() {
      return isAuthenticated() &&
        marketplaceAdminRole() in ['admin', 'superAdmin'];
    }

    match /countries/{country}/domains/marketplace/ai_review_queue/{queueId} {
      allow create: if isAuthenticated()
        && request.resource.data.sellerId == request.auth.uid;
      
      allow read: if canViewMarketplaceReviewQueue();
      allow update: if canModerateMarketplaceReviewQueue();
      allow delete: if false;
    }

    match /countries/{country}/domains/marketplace/admin_audit_logs/{logId} {
      allow read: if canViewMarketplaceReviewQueue();
      allow create: if canModerateMarketplaceReviewQueue();
      allow update, delete: if false;
    }

    // [3] 채팅
    match /chat_rooms/{roomId} {
      allow read: if isAuthenticated() 
        && request.auth.uid in resource.data.participants;
      
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participants;

      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageType', 'lastMessageAt', 'lastSenderId', 'unreadCountByUser', 'updatedAt', 'isArchivedByUser']);

      match /messages/{messageId} {
        allow read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants;
        
        allow create: if isAuthenticated()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants;
          
        allow update: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'status']);
          
        allow delete: if false;
      }
    }

    // [4] 알림
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow update: if isAuthenticated() 
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);
      allow create, delete: if false; // Only via Cloud Functions
    }

    // [5] 신고
    match /reports/{reportId} {
      allow create: if isAuthenticated() 
        && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false; // Only admin (via console)
    }

    // [Deals and Private Codes - P2-B23 MVP]
    match /countries/{country}/domains/marketplace/deals/{dealId} {
      allow read: if isAuthenticated() 
        && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow create: if isAuthenticated() 
        && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAuthenticated() 
        && resource.data.sellerId == request.auth.uid 
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.buyerId == resource.data.buyerId;
      allow delete: if false;
    }

    
    // [Collection Group] 모든 도메인의 'posts' 컬렉션에 공통 적용
    match /{path=**}/posts/{postId} {
      allow read: if isAuthenticated();
    }

    match /{path=**}/likes/{userId} {
      allow read: if isAuthenticated();
    }

    // [Jobs Domain]
    match /job_posts/{jobId} {
      allow read: if isAuthenticated() 
        && resource.data.isDeleted == false
        && (resource.data.status != 'archived' || resource.data.ownerId == request.auth.uid);
      
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.isDeleted == false;

      allow update: if isAuthenticated()
        && (
          // Owner can update everything except immutable fields
          (resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.createdAt == resource.data.createdAt)
          ||
          // Others can only increment applicantCount or chatCount by exactly 1
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicantCount', 'chatCount', 'updatedAt'])
            && (request.resource.data.applicantCount == resource.data.applicantCount || request.resource.data.applicantCount == resource.data.applicantCount + 1)
            && (request.resource.data.chatCount == resource.data.chatCount || request.resource.data.chatCount == resource.data.chatCount + 1)
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.status == resource.data.status
            && request.resource.data.isDeleted == resource.data.isDeleted)
        );

      allow delete: if false; // MVP: No deletion, use isDeleted

      match /applicants/{applicantId} {
        allow read: if isAuthenticated() 
          && (request.auth.uid == applicantId || request.auth.uid == get(/databases/$(database)/documents/job_posts/$(jobId)).data.ownerId);
        
        allow create: if isAuthenticated() 
          && request.auth.uid == applicantId
          && request.resource.data.applicantId == request.auth.uid
          && request.resource.data.jobId == jobId
          && get(/databases/$(database)/documents/job_posts/$(jobId)).data.status == 'open'
          && get(/databases/$(database)/documents/job_posts/$(jobId)).data.isDeleted == false
          && request.resource.data.status in ['new', 'newApplicant']
          && applicantId != get(/databases/$(database)/documents/job_posts/$(jobId)).data.ownerId;
          
        allow update: if isAuthenticated()
          && (
            // Owner can update status and metadata
            (get(/databases/$(database)/documents/job_posts/$(jobId)).data.ownerId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'lastInteractionAt', 'messagePreview']))
            ||
            // Applicant can update their own record (e.g. chatRoomId sync)
            (request.auth.uid == applicantId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chatRoomId', 'updatedAt', 'lastInteractionAt', 'messagePreview'])
              && request.resource.data.status == resource.data.status
              && request.resource.data.applicantId == resource.data.applicantId
              && request.resource.data.jobId == resource.data.jobId)
          );
      }
    }
  }
}
